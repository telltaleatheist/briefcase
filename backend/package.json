{
  "name": "briefcase-backend",
  "version": "1.0.0",
  "description": "NestJS backend for Briefcase media library manager",
  "author": "Your Name",
  "private": true,
  "license": "MIT",
  "//crucible-bootstrap": "Exact @crucible/bootstrap 1.0.25 LIBRARY tarball, vendored so a build is reproducible. It is the code that PERFORMS an install and never the release that GETS installed: which Crucible a machine should have is the release channel's answer, read at install time (crucible docs/INSTALL-UNINSTALL.md 6.5). Never replace with a directory dependency or repack these bytes.",
  "//crucible-client": "CUT RELEASE 1.0.25: @crucible/client and @crucible/bootstrap are the vendored tarballs from crucible's v1.0.25 GitHub release (node tools/adopt-crucible-release.mjs <ver>, run from the repo root, fetches, repins and relinks). It is NOT a statement about which server this app can talk to; compatibility is the API version on X-Crucible-Api. Repin with the same tool, never by hand.",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:crucible": "jest --roots '<rootDir>/../test/crucible'",
    "test:no-crucible": "jest --roots '<rootDir>/../test/no-crucible'"
  },
  "dependencies": {
    "@crucible/bootstrap": "file:vendor/crucible-bootstrap-1.0.25.tgz",
    "@crucible/client": "file:vendor/crucible-client-1.0.25.tgz",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@nestjs/common": "^11.0.13",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.13",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/platform-socket.io": "^11.0.13",
    "@nestjs/serve-static": "^5.0.3",
    "@nestjs/websockets": "^11.0.13",
    "@types/better-sqlite3": "^7.6.13",
    "@types/socket.io": "^3.0.1",
    "axios": "^1.13.1",
    "better-sqlite3": "^12.4.6",
    "chokidar": "^3.6.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "concat-stream": "^2.0.0",
    "defaults": "^3.0.0",
    "fs-extra": "^11.3.0",
    "path-to-regexp": "^8.2.0",
    "proper-lockfile": "^4.1.2",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "uuid": "^9.0.1",
    "winston": "^3.18.3",
    "youtube-dl-exec": "^2.5.5",
    "yt-dlp-wrap": "^2.3.12"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^11.0.13",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.17.31",
    "@types/proper-lockfile": "^4.1.4",
    "@types/supertest": "^2.0.16",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.3.1",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/../tsconfig.spec.json"
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>",
      "<rootDir>/../test"
    ]
  },
  "optionalDependencies": {
    "@ffprobe-installer/darwin-arm64": "^5.0.1",
    "@ffprobe-installer/win32-x64": "^5.1.0"
  }
}
